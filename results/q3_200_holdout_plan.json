    "changes": [
      "\u9996\u6b21\u5728\u539f\u81ea\u9002\u5e94\u8986\u76d6\u548c\u534a\u5f841150\u7c73\u7684\u516d\u7ad9\u73af\u4e4b\u95f4\uff0c\u6309\u5df2\u77e5\u76ee\u6807\u7684\u6df7\u5408\u5de1\u56de\u957f\u5ea6\u53ca\u68c0\u6d4b\u6210\u672c\u9009\u62e9\u65b9\u6848\uff1b\u9009\u62e9\u540e\u4fdd\u7559\u8be5\u6a21\u5f0f\uff0c\u516d\u7ad9\u73af\u572812\u4e2a\u65cb\u8f6c\u89d2\u4e2d\u6311\u9009\u8f83\u77ed\u8def\u5f84\u3002",
      "\u516d\u7ad9\u73af\u4f7f\u7528\u8fde\u7eed\u8986\u76d6\u8bc1\u660e\u6d88\u9664\u683c\u5fc3\u5916\u5305\u9020\u6210\u7684\u6b8b\u4f59\u641c\u7d22\u3002\u53ea\u6709\u540c\u4e00\u672a\u77e5\u9891\u9053\u5b9e\u9645\u5728\u539f\u70b9\u53ca\u516d\u7ad9\u5168\u90e8\u6c89\u9ed8\uff0c\u624d\u505c\u6b62\u8be5\u9891\u9053\u641c\u7d22\uff1b\u7f3a\u6d4b\u3001\u522b\u7684\u9891\u9053\u6d4b\u8fc7\u3001\u4ec5\u8ba1\u5212\u8bbf\u95ee\u5747\u4e0d\u80fd\u4f5c\u4e3a\u5224\u7a7a\u4f9d\u636e\u3002\u6700\u574f\u63a5\u6536\u8ddd\u79bb988.5114\u7c73\uff0c\u8ddd1000\u7c73\u4e0b\u754c\u670911.4886\u7c73\u4f59\u91cf\u3002",
      "\u6e05\u9664\u4f4d\u7f6e\u4fdd\u630119.9\u7c73\u7684\u5168\u5b9a\u4f4d\u533a\u57df\u8986\u76d6\u4fdd\u8bc1\uff0c\u540c\u65f6\u8003\u8651\u4e0b\u4e00\u6bb5\u8def\u7a0b\uff1a\u5728\u4e24\u4e2a\u5b89\u5168\u7aef\u70b9\u95f4\u9009\u62e9\u4e24\u6bb5\u8def\u7a0b\u548c\u66f4\u77ed\u7684\u843d\u70b9\u3002",
      "\u6bcf\u6b21\u68c0\u6d4b\u524d\u91cd\u67e516\u4e2a\u4e0d\u540c\u6e90\u9891\u9053\u7684\u516c\u5f00\u4e0a\u754c\uff0c\u9632\u6b62\u540c\u7ad9\u626b\u9891\u5217\u8868\u8fc7\u671f\u540e\u4ecd\u68c0\u6d4b\u672a\u77e5\u9891\u9053\uff1b\u5df2\u6709\u7ebf\u7d22\u4f46\u672a\u6e05\u9664\u7684\u9891\u9053\u7ee7\u7eed\u8865\u6d4b\u4e0e\u91cd\u8bd5\u3002",
      "\u4fdd\u7559150\u7c73\u76f4\u63a5\u6e05\u9664\u9608\u503c\u3001250\u7c73\u642d\u8f7d\u8865\u6d4b\u57fa\u7ebf\u3001\u6240\u6709\u5b9a\u4f4d\u515c\u5e95\u548c\u9884\u7b97\u3002\u5355\u6761\u793a\u5411\u5ea6\u6fc0\u8fdb\u903c\u8fd1\u3001\u63d0\u524d\u6e05\u9664\u548c\u6539\u53d8\u642d\u8f7d\u9608\u503c\u7b49\u8bd5\u9a8c\u672a\u83b7\u7a33\u5b9a\u6536\u76ca\uff0c\u672a\u7eb3\u5165\u3002"
    ]
